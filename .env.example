# Engineering Map — build-time configuration.
#
# Copy to `.env.local` for development, and set the same keys in the Vercel
# dashboard (Project → Settings → Environment Variables) for production.
#
# Every NEXT_PUBLIC_* value is INLINED INTO THE BROWSER BUNDLE at build time.
# Nothing secret goes in one, and changing one requires a redeploy — there is
# no runtime toggle. See `src/lib/flags.ts` and PRD §10.

# ── Site identity ───────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Feeds `metadataBase`, `sitemap.ts`,
# `robots.ts` and the Open Graph image URLs. Wrong here means broken link
# previews everywhere.
NEXT_PUBLIC_SITE_URL=https://engineering-map.vercel.app

# ── Feature flags ───────────────────────────────────────────────────────────
# "1" is on. Anything else — including unset and misspelled — is off.

# Reader progress: the covered bit, the rollup meters, and /progress.
# Stored per-browser in localStorage; nothing reaches a server.
#
# NOTE: localStorage is scoped to the origin. Progress marked on the deployed
# site is not visible to `npm run dev` on localhost, and each Vercel preview
# deployment gets its own empty store. That is expected, not a bug.
NEXT_PUBLIC_ENABLE_PROGRESS=1

# Google Analytics 4. Needs NEXT_PUBLIC_GA_ID too, or it stays off.
# After enabling: GA4 Admin → Data Streams → Enhanced Measurement → turn on
# "Page changes based on browser history events", or only the landing page is
# ever recorded.
NEXT_PUBLIC_ENABLE_ANALYTICS=0
NEXT_PUBLIC_GA_ID=

# The site-wide like count. Needs a Redis store — see the server-only keys.
NEXT_PUBLIC_ENABLE_LIKES=0

# Display of the visitor count. Separate from analytics on purpose: the number
# can accrue for weeks before it is worth showing anyone.
NEXT_PUBLIC_ENABLE_VISITORS=0

# The support link. Needs NEXT_PUBLIC_POLAR_CHECKOUT_URL too, or it stays off.
# A Polar hosted Checkout Link — dashboard-created, never expires, no secret.
NEXT_PUBLIC_ENABLE_DONATIONS=0
NEXT_PUBLIC_POLAR_CHECKOUT_URL=

# ── Server-only ─────────────────────────────────────────────────────────────
# No NEXT_PUBLIC_ prefix, so these never reach the browser. Read only inside
# route handlers.

# Injected automatically by the Vercel ↔ Upstash Marketplace integration.
# Set by hand only to develop against a real store. Both spellings are
# accepted; the integration has used each at different times.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for the per-visitor IP hash that rate-limits likes. Any long random
# string — `openssl rand -hex 32`. Rotating it resets the 24h window, nothing
# else. The raw IP is never stored.
LIKES_IP_SALT=

# Google Analytics Data API, for the public visitor count. Create a service
# account, enable the Analytics Data API, then add the service-account email
# as a Viewer on the GA4 property.
# GA_SA_PRIVATE_KEY holds escaped newlines; the route unescapes them.
GA_PROPERTY_ID=
GA_SA_CLIENT_EMAIL=
GA_SA_PRIVATE_KEY=
